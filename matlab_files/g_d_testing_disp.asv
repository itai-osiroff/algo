if size(z_abrr) == 1
    displayLF(LF, 1);
    % [~, ~, ~, ~] = calc_grad_disp(LF, Na, init_mask, x_stp*smp_stp, u_x_max, cost_mask,0, true);
    if diag_flag
        [init_mask, gd_cost, opt_over_early] = perform_gd_disp_diag(LF, init_mask, gd_iter_num, Na, smp_stp, x_stp, u_x_max, cost_mask, k_num, k_limit, gd_step, g_filt_var, thresh_cof);
    else
        [init_mask, gd_cost, opt_over_early] = perform_gd_disp(LF, init_mask, gd_iter_num, Na, smp_stp, x_stp, u_x_max, cost_mask, k_num, k_limit, gd_step, g_filt_var, thresh_cof);
    end
    displayLF(squeeze(init_mask(:, :, :, :, 1)), 1); title("mask ax=1");
    displayLF(squeeze(init_mask(:, :, :, :, 2)), 1); title("mask ax=2");
    [~, ~, ~, lf] = calc_grad_disp(LF, Na, init_mask, x_stp*smp_stp, u_x_max, cost_mask,0, true);
    if diag_flag
        figure; hold on;
        for i = 1:size(gd_cost, 2)
            for j = 1:size(gd_cost, 3)
                plot(1:gd_iter_num, squeeze(gd_cost(:, i, j)), "-o", DisplayName=sprintf("viewpoint: [%.0f, %.0f]", i, j));
            end
        end
        legend;
    else
        figure;hold on; plot(1:gd_iter_num, gd_cost, "r-o");
    end
    % beta1 = 0.9;
    % beta2 = 0.999;
    % epsilon = 1e-8;
    % [x, cost_history] = adam_optim(LF, Na, init_mask, x_stp, smp_stp, u_x_max, cost_mask, 5, beta1, beta2, epsilon, gd_iter_num);
    % [~, ~, ~, ~] = calc_grad_disp(LF, Na, init_mask, x_stp*smp_stp, u_x_max, cost_mask,0, true);
else
    displayLF(LF, 1);
    LF = LF.*(LF>1.5*median(LF, "all"));
    displayLF(LF, 1);
    if ~diag_flag
        init_mask = zeros(size(LF, 1), size(LF, 2), size(LF, 3), size(LF, 3), 2, "gpuArray");
        [init_mask, gd_cost, opt_over_early] = perform_gd_disp(LF, init_mask, gd_iter_num, Na, smp_stp, x_stp, u_x_max, cost_mask, k_num, k_limit, gd_step, g_filt_var, thresh_cof);
    else
        [init_mask, gd_cost, opt_over_early] = perform_gd_disp_diag(LF, init_mask, gd_iter_num, Na, smp_stp, x_stp, u_x_max, cost_mask, k_num, k_limit, gd_step, g_filt_var, thresh_cof);
    end
    displayLF(squeeze(init_mask(:, :, :, :, 1)), 1); title("mask ax=1");colorbar;
    displayLF(squeeze(init_mask(:, :, :, :, 2)), 1); title("mask ax=2");colorbar;
    [~, ~, ~, lf] = calc_grad_disp(LF, Na, init_mask, x_stp*smp_stp, u_x_max, cost_mask, 0, true);
    if diag_flag
        figure; hold on;
        for i = 1:size(gd_cost, 2)
            for j = 1:size(gd_cost, 3)
                plot(1:gd_iter_num, squeeze(gd_cost(:, i, j)), "-o", DisplayName=sprintf("viewpoint: [%.0f, %.0f]", i, j));
            end
        end
        legend;
    else
        figure;hold on; plot(1:gd_iter_num, gd_cost, "r-o");
    end
end

keyboard

if exist("mask_s", "var")
    [~, ideal_cost, ~, ~] = calc_grad(LF, Na, Nxw, smp_stp, stp_ratio, -mask_s, z_abrr, x_stp*smp_stp, x_max, lf_ang_grid, u_x_max, cost_mask, 0, false); % The so-called ideal cost, score of the mask from the simulation
end
init_cost = min(gd_cost, [], "all"); % initial cost of init_mask
figure; hold on; plot(1:gd_iter_num, (gd_cost-ones(size(gd_cost))*init_cost)/init_cost*100, "r-o", "DisplayName", "w.r.t initial score");
figure; hold on; plot(1:gd_iter_num, gd_cost, "r-o", "DisplayName", "w.r.t initial score");
% plot(1:gd_iter_num, gd_cost/ideal_cost*100, "b-o", "DisplayName", "w.r.t score of the simulation mask")
xlabel("GD iteration #"); ylabel("% improvement");
legend show
